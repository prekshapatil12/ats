<odoo>
  <template id="post_job_form_template" name="Post Job Form">
    <t t-call="website.layout">
      <div class="container mt-5">
        <h2 class="mb-4">Post a New Job</h2>
        <form action="/submit_job" method="POST">
          <div class="form-group">
            <label>Job ID</label>
            <input type="text" name="job_id" class="form-control" required/>
          </div>
          <div class="form-group">
            <label>Job Title</label>
            <input type="text" name="job_title" class="form-control" required/>
          </div>
          <div class="form-group">
            <label>Experience</label>
            <input type="text" name="experience" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Responsibilities</label>
            <textarea name="responsibilities" class="form-control"></textarea>
          </div>
          <div class="form-group">
            <label>Requirements</label>
            <textarea name="requirement" class="form-control"></textarea>
          </div>
          <div class="form-group">
            <label>Shift</label>
            <input type="text" name="shift" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Salary</label>
            <input type="text" name="salary" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Skills</label>
            <input type="text" name="skills" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Status</label>
            <input type="text" name="status" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Company</label>
            <input type="text" name="company" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Location</label>
            <input type="text" name="location" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Workplace Type</label>
            <input type="text" name="workplace_type" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Posted Date</label>
            <input type="date" name="posted_date" class="form-control"/>
          </div>
          <div class="form-group">
            <label>Joining Tentative Date</label>
            <input type="date" name="joining_tentative_date" class="form-control"/>
          </div>
          <button type="submit" class="btn btn-success mt-3">Submit Job</button>
        </form>
      </div>
    </t>
  </template>
</odoo>
