<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="job_listing_template" name="Job Listing Page">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h2 class="text-center mb-4">Job Listings</h2>

                <table class="table table-striped table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>Job ID</th>
                            <th>Title</th>
                            <th>Experience</th>
                            <th>Company</th>
                            <th>Location</th>
                            <th>Salary</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="jobs" t-as="job">
                            <tr>
                                <td><t t-esc="job.job_id"/></td>
                                <td><t t-esc="job.job_title"/></td>
                                <td><t t-esc="job.experience"/></td>
                                <td><t t-esc="job.company"/></td>
                                <td><t t-esc="job.location"/></td>
                                <td><t t-esc="job.salary"/></td>
                                <td><t t-esc="job.status"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>
</odoo>
