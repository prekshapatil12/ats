<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Job Listing Page -->
    <template id="job_listings_template" name="Job Listings">
        <t t-call="website.layout">
            <div class="container mt-4 mb-5">
                <h1 class="text-center mb-4">Job Openings</h1>
                <div class="row">
                    <t t-foreach="jobs" t-as="job">
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <a t-att-href="'/jobs/' + job.job_id" class="text-decoration-none">
                                            <t t-esc="job.job_title"/>
                                        </a>
                                    </h5>
                                    <p class="card-text">
                                        <strong>Company:</strong> <t t-esc="job.company"/><br/>
                                        <strong>Location:</strong> <t t-esc="job.location"/><br/>
                                        <strong>Experience:</strong> <t t-esc="job.experience"/><br/>
                                        <strong>Status:</strong> <t t-esc="job.status"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- Job Detail Page -->
    <template id="job_detail_template" name="Job Detail">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h1><t t-esc="job.job_title"/></h1>
                <p><strong>Company:</strong> <t t-esc="job.company"/></p>
                <p><strong>Location:</strong> <t t-esc="job.location"/></p>
                <p><strong>Experience Required:</strong> <t t-esc="job.experience"/></p>
                <p><strong>Salary:</strong> <t t-esc="job.salary"/></p>
                <p><strong>Workplace Type:</strong> <t t-esc="job.workplace_type"/></p>
                <p><strong>Shift:</strong> <t t-esc="job.shift"/></p>
                <p><strong>Posted Date:</strong> <t t-esc="job.posted_date"/></p>
                <p><strong>Joining Tentative Date:</strong> <t t-esc="job.joining_tentative_date"/></p>
                <h4>Responsibilities</h4>
                <p><t t-esc="job.responsibilities"/></p>
                <h4>Requirements</h4>
                <p><t t-esc="job.requirement"/></p>
                <h4>Skills</h4>
                <p><t t-esc="job.skills"/></p>
            </div>
        </t>
    </template>

</odoo>
