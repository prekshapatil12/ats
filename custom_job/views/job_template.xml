<odoo>
  <template id="job_page_template" name="Job Page">
    <t t-call="website.layout">
    <style type="text/css">
        .my-custom-table {
           width: 100%;
           border-collapse: collapse;
            background-color: #ffffff;
            color: #343a40;
            font-size: 1rem;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);
            border-radius: 8px;
            overflow: hidden;
        }
        .my-custom-table th {
          background-color: #003366;
          color: #ffffff;
          text-align: left;
          padding: 0.75rem;
          font-weight: bold;
        }
        .my-custom-table td {
          padding: 0.75rem;
          border-bottom: 1px solid #dee2e6;
        }
        .my-custom-table tr:nth-child(even) {
          background-color: #f9fbfd;
        }
        .my-custom-table td:hover {
          background-color: #f1f1f1;
        }
        @media (max-width: 1000px) {
          .my-custom-table,
          .my-custom-table thead,
          .my-custom-table tbody,
          .my-custom-table th,
          .my-custom-table td,
          .my-custom-table tr {
            display: block;
            width: 100%;
          }
          .my-custom-table td::before {
            content: attr(data-label);
            position: absolute;
            left: 1rem;
            top: 0.75rem;
            font-weight: 600;
            color: #003366;
            white-space: nowrap;
          }
        }
      </style>

      <div class="container mt-4">
        <h1 class="mb-4">Available Job Postings</h1>

        <!-- Create Job Button -->
        <div class="mb-3">
          <a href="/create-job" class="btn btn-primary">+ Create Job</a>
        </div>

        <t t-set="jobs" t-value="request.env['job.postings'].sudo().search([])"/>

        <table class="my-custom-table">
          <thead class="my-custom-table">
            <tr>
              <th>Job ID</th>
              <th>Title</th>
              <th>Experience</th>
              <th>Responsibilities</th>
              <th>Requirements</th>
              <th>Shifts</th>
              <th>Salary</th>
              <th>Skills</th>
              <th>Status</th>
              <th>Company</th>
              <th>Location</th>
              <th>Workplace</th>
              <th>Posted Date</th>
              <th>Joining Date</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="jobs" t-as="job">
              <tr>
                <td><t t-esc="job.job_id" /></td>
                <td><t t-esc="job.job_title" /></td>
                <td><t t-esc="job.experience" /></td>
                <td><t t-esc="job.responsibilities" /></td>
                <td><t t-esc="job.requirement" /></td>
                <td><t t-esc="job.shift" /></td>
                <td><t t-esc="job.salary" /></td>
                <td><t t-esc="job.skills" /></td>
                <td><t t-esc="job.status" /></td>
                <td><t t-esc="job.company" /></td>
                <td><t t-esc="job.location" /></td>
                <td><t t-esc="job.workplace_type" /></td>
                <td><t t-esc="job.posted_date" /></td>
                <td><t t-esc="job.joining_tentative_date" /></td>
              </tr>
            </t>
          </tbody>
        </table>
      </div>
    </t>
  </template>
</odoo>
