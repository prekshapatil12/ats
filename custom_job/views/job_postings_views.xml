<odoo>
    <data>
        <!-- Create the View -->
        <record id="view_job_page" model="ir.ui.view">
            <field name="name">job.page</field>
            <field name="model">ir.ui.view</field>
            <field name="arch" type="xml">
                <div class="oe_structure"/>
                <h1>Hello Job</h1>
            </field>
        </record>

        <!-- Define the Action for the Page -->
        <record id="action_job_page" model="ir.actions.act_url">
            <field name="name">Job Page</field>
            <field name="url">/job</field>
            <field name="type">ir.actions.act_url</field>
        </record>

        <!-- Create a Menu item to access the Job Page -->
        <menuitem id="menu_job" name="Job" sequence="10"/>
        <menuitem id="menu_job_page" name="Job Page" parent="menu_job" action="action_job_page"/>
    </data>
</odoo>
