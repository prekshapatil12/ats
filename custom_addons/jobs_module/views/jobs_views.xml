<odoo>
    <record id="view_ats_job_form" model="ir.ui.view">
        <field name="name">ats.job.form</field>
        <field name="model">ats.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="location"/>
                        <field name="job_type"/>
                        <field name="is_active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ats_job_tree" model="ir.ui.view">
        <field name="name">ats.job.tree</field>
        <field name="model">ats.job</field>
        <field name="arch" type="xml">
            <tree string="Jobs">
                <field name="name"/>
                <field name="location"/>
                <field name="job_type"/>
                <field name="is_active"/>
            </tree>
        </field>
    </record>

    <record id="action_ats_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">ats.job</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="ats_menu_root" name="ATS"/>
    <menuitem id="ats_menu_jobs" name="Jobs" parent="ats_menu_root" action="action_ats_job"/>
</odoo>
