<odoo>
  <data>

    <!-- Your original template -->
    <template id="custom_job_page" name="Custom Job Page">
      <t t-call="website.layout">
        <div class="container">
          <h1>Jobs</h1>
          <t t-foreach="jobs" t-as="job">
            <div class="card">
              <h2><t t-esc="job.name"/></h2>
              <p><t t-esc="job.description"/></p>
            </div>
          </t>
        </div>
      </t>
    </template>

    <!-- Route to publish the page -->
    <record id="custom_job_page_route" model="website.page">
      <field name="name">Custom Job Page</field>
      <field name="url">/jobs</field> <!-- URL you want -->
      <field name="view_id" ref="custom_job_page"/>
      <field name="website_published" eval="True"/>
    </record>

  </data>
</odoo>
