<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="view_custom_job_tree" model="ir.ui.view">
    <field name="name">custom.job.tree</field>
    <field name="model">custom.job</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name"/>
        <field name="department"/>
        <field name="is_active"/>
      </tree>
    </field>
  </record>

  <record id="view_custom_job_form" model="ir.ui.view">
    <field name="name">custom.job.form</field>
    <field name="model">custom.job</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="name"/>
          <field name="department"/>
          <field name="description"/>
          <field name="is_active"/>
        </group>
      </form>
    </field>
  </record>

  <record id="action_custom_job" model="ir.actions.act_window">
    <field name="name">Jobs</field>
    <field name="res_model">custom.job</field>
    <field name="view_mode">tree,form</field>
  </record>

  <menuitem id="custom_job_menu_root" name="Job Management"/>
  <menuitem id="custom_job_menu" name="Jobs" parent="custom_job_menu_root" action="action_custom_job"/>
</odoo>