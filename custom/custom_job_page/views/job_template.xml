<!-- ats-1/views/job_template.xml -->
<odoo>
    <template id="custom_job_page_template" name="Custom Job List">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">
                <h2>Available Job Openings</h2>
                <t t-if="jobs">
                    <ul>
                        <t t-foreach="jobs" t-as="job">
                            <li>
                                <strong><t t-esc="job.name"/></strong><br/>
                                <span><t t-esc="job.description"/></span><br/>
                                <em><t t-esc="job.address_id.name if job.address_id else ''"/></em>
                            </li>
                        </t>
                    </ul>
                </t>
                <t t-else="">
                    <p>No jobs found.</p>
                </t>
            </div>
        </t>
    </template>
</odoo>
